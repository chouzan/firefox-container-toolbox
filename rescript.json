{
  "name": "container-toolbox",
  "sources": [
    { "dir": "src/lib", "subdirs": true },
    { "dir": "src/background", "subdirs": true }
  ],
  "package-specs": [
    { "module": "esmodule", "in-source": true }
  ],
  "suffix": ".res.mjs",
