{
  "manifest_version": 3,
  "name": "Container Toolbox",
  "version": "0.1.0",
  "description": "Name-based container management with STG integration and Google Drive sync",
  "permissions": [
    "contextualIdentities",
    "cookies",
    "storage",
    "downloads",
    "notifications",
    "identity"
  ],
  "background": {
    "scripts": ["background.js"]
  },
  "action": {
    "default_title": "Container Toolbox",
    "default_popup": "ui/popup/popup.html",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png"
    }
  },
  "options_ui": {
    "page": "ui/options/options.html",
    "open_in_tab": true
  },
  "icons": {
    "48": "icons/icon-48.png",
    "96": "icons/icon-96.png",
    "128": "icons/icon-128.png"
  },
  "browser_specific_settings": {
    "gecko": {
      "id": "container-toolbox@chouzan",
      "strict_min_version": "128.0",
      "data_collection_permissions": {
        "required": ["none"],
        "optional": []
      }
    }
  }
}
